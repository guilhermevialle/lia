{
  "name": "@guivialle/lia",
  "version": "0.0.0-development",
  "description": "Reusable library for dynamic Leaflet layer management with React",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsup src/index.ts --format cjs,esm --clean --minify && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware"
  },
  "keywords": [],
  "author": "Guilherme Vialle",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.20.4",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/geojson": "^7946.0.16"
  },
  "peerDependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.20.4",
    "leaflet": "^1.9.4"
  }
}
